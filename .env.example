# -----------------------------------------------------------------------------
# Learning Assistant & Course Escalations - Environment Configuration
# -----------------------------------------------------------------------------

# Secret token required in 'X-Helper-Token' header for tutor/helper endpoints
HELPER_TOKEN=replace-with-a-long-random-token

# Webhook endpoint URL: receives { event: "ticket.opened", ticketId, at } POSTs
# Test locally with requestcatcher (e.g. https://your-subdomain.requestcatcher.com/test)
WEBHOOK_URL=https://example.org/webhook

# SQLite database file path (defaults to api/escalations.sqlite3)
ESCALATIONS_DB=api/escalations.sqlite3

# Automatically purge tutor tickets and attachments after this many days (0 disables expiry)
TICKET_RETENTION_DAYS=90

# AI Q&A Provider: 'none' (pure search fallback), 'local' (Ollama), or 'cloud'
AI_PROVIDER=none

# Search similarity threshold (0.0 to 1.0; default: 0.25)
THRESHOLD=0.25

# Per-process request limits (0 disables an individual limit; window is shared)
RATE_LIMIT_ASK=120
RATE_LIMIT_ESCALATIONS=20
RATE_LIMIT_SMS=30
RATE_LIMIT_VOICE=60
RATE_LIMIT_WINDOW_SECONDS=60
TUTOR_STALE_MINUTES=60

# Backend offline guarantee for Docker Compose (true by default).
OFFLINE_MODE=true

# Set true only after you configure a public HTTPS callback URL and Twilio credentials.
# Signed form callbacks at /sms/inbound and /voice/* are then validated against TWILIO_AUTH_TOKEN.
TWILIO_WEBHOOKS_ENABLED=false
# Public origin only, e.g. https://your-domain.example (no path or trailing endpoint).
# Used to reconstruct Twilio's signed webhook URL behind NGINX and build absolute voice callback URLs.
TWILIO_WEBHOOK_BASE_URL=

# Voice actions use a stable secret for signed drafts and learner ticket tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VOICE_ACTION_SECRET=
VOICE_PROVIDER=local
# Optional local audio models; install FFmpeg, Vosk (pip install vosk), and Piper separately.
FFMPEG_EXECUTABLE=ffmpeg
PIPER_EXECUTABLE=piper
# VOICE_STT_MODEL_EN=/models/vosk-en
# VOICE_TTS_MODEL_EN=/models/en_US-lessac-medium.onnx
# Point the phone provider's inbound-call webhook to https://YOUR-HOST/voice/inbound (POST).
# For Twilio, enable signed webhook validation above. Voice answer callbacks use the public base URL
# plus /voice/answer unless VOICE_CALL_ANSWER_URL is explicitly configured as an absolute HTTPS URL.
# English is the working default for common TwiML providers. Set am only if your provider
# supports both Amharic speech recognition and TTS; supported locales vary by provider.
VOICE_CALL_LANGUAGE=en
VOICE_CALL_LOCALE_AM=am-ET
VOICE_CALL_VOICE_AM=
VOICE_CALL_ANSWER_URL=
VOICE_CALL_LOCALE_EN=en-US
VOICE_CALL_VOICE_EN=

# Local Ollama OpenAI-compatible endpoint and model (used when AI_PROVIDER=local)
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Cloud OpenAI-compatible endpoint and model (used when AI_PROVIDER=cloud)
CLOUD_URL=https://api.openai.com/v1/chat/completions
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini

# Telegram Bot integration (only required when running telegram profile).
# Create a bot with @BotFather, set OFFLINE_MODE=false, then run:
#   docker compose --profile telegram up --build -d
TELEGRAM_BOT_TOKEN=
COURSE_BASE_URL=https://github.com/hudahussen2424-hash/acceseblity-hackthon/blob/main/
# Telegram voice notes use VOICE_STT_MODEL_AM and VOICE_TTS_MODEL_AM when configured.

# SMS Alert Delivery (subscriber phone numbers are encrypted at rest with Fernet)
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMS_ENCRYPTION_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
